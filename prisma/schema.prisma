generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum MatchStatus {
  UPCOMING
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
}

enum SponsorTier {
  MAIN
  GOLD
  SILVER
  BRONZE
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String?
  role          Role      @default(MEMBER)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@map("verification_tokens")
}

model News {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String   @db.Text
  excerpt     String?
  image       String?
  category    String   @default("Genel")
  published   Boolean  @default(false)
  publishedAt DateTime?
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("news")
}

model Branch {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  matches Match[]
  players Player[]

  @@map("branches")
}

model Match {
  id        String      @id @default(cuid())
  homeTeam  String
  awayTeam  String
  homeScore Int?
  awayScore Int?
  date      DateTime
  venue     String?
  league    String?
  status    MatchStatus @default(UPCOMING)
  branchId  String
  branch    Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("matches")
}

model Player {
  id          String    @id @default(cuid())
  firstName   String
  lastName    String
  number      Int?
  position    String?
  photo       String?
  birthDate   DateTime?
  nationality String?   @default("Türkiye")
  bio         String?   @db.Text
  active      Boolean   @default(true)
  branchId    String
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("players")
}

model SliderItem {
  id          String   @id @default(cuid())
  image       String
  title       String?
  description String?
  link        String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("slider_items")
}

model Sponsor {
  id        String      @id @default(cuid())
  name      String
  logo      String
  website   String?
  tier      SponsorTier @default(BRONZE)
  active    Boolean     @default(true)
  order     Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("sponsors")
}

model SiteSettings {
  id          String   @id @default(cuid())
  siteName    String   @default("Erzurum Üniversiteli Gençler SK")
  logo        String?
  favicon     String?
  email       String?
  phone       String?
  address     String?
  facebook    String?
  twitter     String?
  instagram   String?
  youtube     String?
  description String?
  keywords    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("site_settings")
}

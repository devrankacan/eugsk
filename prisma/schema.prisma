generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum MatchStatus {
  UPCOMING
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
}

enum TableType {
  LEAGUE
  TOURNAMENT
  GROUP
}

enum SponsorTier {
  MAIN
  GOLD
  SILVER
  BRONZE
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  phone         String?
  password      String?
  role          Role      @default(MEMBER)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@map("verification_tokens")
}

model News {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String   @db.Text
  excerpt     String?
  image       String?
  images      String[]
  sourceUrl   String?
  category    String   @default("Genel")
  published   Boolean  @default(false)
  publishedAt DateTime?
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("news")
}

model Branch {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  gender      String   @default("KARMA")
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  matches        Match[]
  players        Player[]
  ageCategories  AgeCategory[]
  leagueTables   LeagueTable[]

  @@map("branches")
}

model AgeCategory {
  id       String  @id @default(cuid())
  name     String
  branchId String
  branch   Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  players  Player[]
  order    Int     @default(0)
  active   Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("age_categories")
}

model Match {
  id        String      @id @default(cuid())
  homeTeam  String
  awayTeam  String
  homeLogo  String?
  awayLogo  String?
  homeScore Int?
  awayScore Int?
  date      DateTime
  venue     String?
  league    String?
  status    MatchStatus @default(UPCOMING)
  branchId  String
  branch    Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("matches")
}

model LeagueTable {
  id        String    @id @default(cuid())
  name      String
  season    String?
  type      TableType @default(LEAGUE)
  branchId  String
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  rows      LeagueTableRow[]
  active    Boolean   @default(true)
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("league_tables")
}

model LeagueTableRow {
  id           String      @id @default(cuid())
  tableId      String
  table        LeagueTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  teamName     String
  teamLogo     String?
  played       Int         @default(0)
  won          Int         @default(0)
  drawn        Int         @default(0)
  lost         Int         @default(0)
  goalsFor     Int         @default(0)
  goalsAgainst Int         @default(0)
  points       Int         @default(0)
  order        Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("league_table_rows")
}

model Player {
  id             String       @id @default(cuid())
  firstName      String
  lastName       String
  number         Int?
  position       String?
  photo          String?
  birthDate      DateTime?
  nationality    String?      @default("Türkiye")
  bio            String?      @db.Text
  playerGender   String       @default("ERKEK")
  ageCategoryId  String?
  ageCategory    AgeCategory? @relation(fields: [ageCategoryId], references: [id])
  active         Boolean      @default(true)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("players")
}

model SliderItem {
  id          String   @id @default(cuid())
  image       String
  title       String?
  description String?
  link        String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("slider_items")
}

model Sponsor {
  id        String      @id @default(cuid())
  name      String
  logo      String
  website   String?
  tier      SponsorTier @default(BRONZE)
  active    Boolean     @default(true)
  order     Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("sponsors")
}

model SiteSettings {
  id          String   @id @default(cuid())
  siteName    String   @default("Erzurum Üniversiteli Gençler SK")
  logo        String?
  favicon     String?
  email       String?
  phone       String?
  address     String?
  facebook    String?
  twitter     String?
  instagram   String?
  youtube     String?
  description String?
  keywords    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("site_settings")
}

model BoardMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  photo     String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("board_members")
}

model PageVisit {
  id        String   @id @default(cuid())
  path      String
  pageTitle String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
  @@map("page_visits")
}
